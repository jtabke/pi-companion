{
	"name": "pi-companion",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"pi": {
		"extensions": [
			"./src/extension/bridge.ts"
		]
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"setup:types": "python3 -B scripts/link-pi-declarations.py",
		"typecheck": "tsc --noEmit",
		"analyze": "fallow",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "tsc -p tsconfig.node.json && vite build",
		"start": "node dist/gateway/cli.js",
		"restart": "node scripts/restart.mjs",
		"screenshots": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.cache/playwright node scripts/screenshots.mjs",
		"test": "npm run build && vitest run",
		"test:browser": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright test",
		"check": "npm run typecheck && npm test && npm run test:browser",
		"test:pi": "python3 -B tests/real-pi.py"
	},
	"dependencies": {
		"@fastify/cookie": "11.1.2",
		"@fastify/helmet": "13.1.1",
		"@fastify/static": "10.1.5",
		"fastify": "5.12.5",
		"fs-ext": "2.1.1",
		"lowlight": "3.3.0",
		"photoswipe": "5.4.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/fs-ext": "2.0.3",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"fallow": "3.30.0",
		"prettier": "3.9.9",
		"typescript": "5.9.3",
		"vite": "8.3.1",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@sinclair/typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}

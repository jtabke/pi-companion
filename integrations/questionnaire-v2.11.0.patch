+		{ ...reply, answers: [{ ...option, notes: {} }] },
+		{ ...reply, extra: "x".repeat(65536) },
+		{ ...reply, cancelled: "false" },
+		{ ...reply, answers: [{ ...option, kind: "other" }] },
+		null,
+	])("rejects malformed, unowned or oversized reply %#", (value) => {
+		expect(validateCompanionReply(value, params)).toBeUndefined();
+	});
+});
+
+describe("CompanionReplies — once-only completion", () => {

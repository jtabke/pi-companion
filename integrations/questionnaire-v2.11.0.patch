+		first.ready();
+		second.bind(secondDone);
+		second.ready();
+		events.emit(REPLY, { ...reply, invocationId: first.invocationId, replyId: "first" });
+		expect(firstDone).toHaveBeenCalledOnce();
+		expect(secondDone).not.toHaveBeenCalled();
+		events.emit(REPLY, { ...reply, invocationId: first.invocationId, replyId: "stale" });
+		expect(secondDone).not.toHaveBeenCalled();

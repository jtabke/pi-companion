+++ b/packages/rpiv-ask-user-question/companion-replies.ts
@@ -0,0 +1,198 @@
+import { randomUUID } from "node:crypto";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import {
+	ASK_USER_CLOSED_EVENT,
+	ASK_USER_REPLY_EVENT,
+	ASK_USER_REPLY_MAX_BYTES,
+	ASK_USER_REPLY_MAX_TEXT_LENGTH,
+	ASK_USER_REPLY_OUTCOME_EVENT,
+	ASK_USER_REQUEST_EVENT,
+	type AskUserClosedEventPayload,
+	type AskUserReplyOutcomeEventPayload,
+} from "./events.js";
+import type { QuestionAnswer, QuestionnaireResult, QuestionParams } from "./tool/types.js";
+
+function object(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+function text(value: unknown): value is string {
+	return typeof value === "string" && value.length <= ASK_USER_REPLY_MAX_TEXT_LENGTH;
+}
+
+/** Reconstruct owner-authored fields; echoed question/preview fields never reach the result. */
+export function validateCompanionReply(value: unknown, params: QuestionParams): QuestionnaireResult | undefined {
+	try {
+		const json = JSON.stringify(value);
+		if (!json || Buffer.byteLength(json, "utf8") > ASK_USER_REPLY_MAX_BYTES) return undefined;
+	} catch {
+		return undefined;
+	}
+	if (!object(value) || typeof value.cancelled !== "boolean" || !Array.isArray(value.answers)) return undefined;
+	if (value.answers.length > params.questions.length) return undefined;
+	if (value.globalNote !== undefined && !text(value.globalNote)) return undefined;
+	const seen = new Set<number>();
+	const answers: QuestionAnswer[] = [];
+	for (const entry of value.answers) {
+		if (!object(entry) || !Number.isInteger(entry.questionIndex)) return undefined;
+		const index = entry.questionIndex as number;
+		const question = params.questions[index];
+		if (!question || seen.has(index)) return undefined;
+		seen.add(index);
+		if (entry.notes !== undefined && !text(entry.notes)) return undefined;
+		const base = {
+			questionIndex: index,
+			question: question.question,
+			...(typeof entry.notes === "string" && entry.notes.trim() ? { notes: entry.notes } : {}),
+		};
+		if (entry.kind === "option") {
+			if (question.multiSelect || typeof entry.answer !== "string") return undefined;
+			const option = question.options.find((o) => o.label === entry.answer);
+			if (!option) return undefined;
+			answers.push({
+				...base,
+				kind: "option",
+				answer: option.label,
+				...(option.preview ? { preview: option.preview } : {}),
+			});
+		} else if (entry.kind === "custom") {
+			if (entry.answer !== null && !text(entry.answer)) return undefined;
+			answers.push({ ...base, kind: "custom", answer: entry.answer as string | null });
+		} else if (entry.kind === "multi") {
+			if (!question.multiSelect || entry.answer !== null || !Array.isArray(entry.selected)) return undefined;
+			if (entry.selected.length > question.options.length || new Set(entry.selected).size !== entry.selected.length)
+				return undefined;
+			if (
+				![...entry.selected].every(
+					(label) => typeof label === "string" && question.options.some((o) => o.label === label),
+				)
+			)
+				return undefined;
+			answers.push({ ...base, kind: "multi", answer: null, selected: [...entry.selected] as string[] });
+		} else return undefined;
+	}
+	return {
+		answers,
+		cancelled: value.cancelled,
+		...(typeof value.globalNote === "string" && value.globalNote.trim() ? { globalNote: value.globalNote } : {}),
+	};
+}
+
+/** One invocation's completion owner. No retained IDs or listeners after closure. */
+export class CompanionReplies {
+	readonly invocationId = randomUUID();
+	private done: ((result: QuestionnaireResult) => void) | undefined;
+	private winner: QuestionnaireResult | undefined;
+	private settled = false;
+	private published = false;
+	private mounted = false;
+	private delivered = false;
+	private removeReply: (() => void) | undefined;
+	private readonly onAbort = () => this.cancel("aborted");
+
+	constructor(
+		private readonly pi: ExtensionAPI,
+		private readonly params: QuestionParams,
+		private readonly signal?: AbortSignal,
+	) {
+		signal?.addEventListener("abort", this.onAbort, { once: true });
+		if (signal?.aborted) this.onAbort();
+	}
+
+	/** A cancellation received during lazy loading must not open a new overlay. */
+	get completedResult(): QuestionnaireResult | undefined {
+		return this.winner;
+	}
+
+	bind(done: (result: QuestionnaireResult) => void): void {
+		this.done = done;
+	}
+
+	/** Called only after successful component construction AND public onHandle readiness. */
+	ready(): void {
+		if (this.mounted || !this.done) return;
+		this.mounted = true;
+		// Pi's done removes the overlay: never invoke it before onHandle has mounted ours.
+		if (this.settled) {
+			this.deliver();
+			return;
+		}
+		this.published = true;
+		this.removeReply = this.pi.events.on(ASK_USER_REPLY_EVENT, (value: unknown) => {
+			if (!object(value) || value.invocationId !== this.invocationId) return;
+			if (typeof value.replyId !== "string" || !value.replyId.length || value.replyId.length > 128) return;
+			// Also guards a callback captured by an event dispatch before unsubscription.
+			if (this.settled) return;
+			const result = validateCompanionReply(value, this.params);
+			if (!result) {
+				this.outcome(value.replyId, false);
+				return;
+			}
+			this.finish(result, "external", value.replyId);
+		});
+		this.pi.events.emit(ASK_USER_REQUEST_EVENT, {
+			invocationId: this.invocationId,
+			questions: this.params.questions.map((q) => ({
+				question: q.question,
+				header: q.header,
+				multiSelect: q.multiSelect ?? false,
+				options: q.options.map((o) => ({
+					label: o.label,
+					description: o.description,
+					...(o.preview !== undefined ? { preview: o.preview } : {}),
+				})),
+			})),
+		});
+	}
+
+	terminal(result: QuestionnaireResult): void {
+		this.finish(result, "terminal");
+	}
+	cancel(reason: "aborted" | "shutdown"): void {
+		this.finish({ answers: [], cancelled: true }, reason);
+	}
+	close(): void {
+		if (!this.settled) {
+			this.settled = true;
+			this.cleanup();
+			this.closed("ended");
+		}
+	}
+	private finish(result: QuestionnaireResult, reason: AskUserClosedEventPayload["reason"], replyId?: string): void {
+		if (this.settled) return;
+		this.settled = true;
+		this.winner = result;
+		this.cleanup();
+		try {
+			if (this.mounted || reason === "terminal") this.deliver();
+		} finally {
+			if (replyId) this.outcome(replyId, true);
+			this.closed(reason);
+		}
+	}
+	private deliver(): void {
+		if (this.delivered || !this.done || !this.winner) return;
+		this.delivered = true;
+		this.done(this.winner);
+	}
+	private cleanup(): void {
+		this.removeReply?.();
+		this.removeReply = undefined;
+		this.signal?.removeEventListener("abort", this.onAbort);
+	}
+	private outcome(replyId: string, accepted: boolean): void {
+		const payload: AskUserReplyOutcomeEventPayload = {
+			invocationId: this.invocationId,
+			replyId,
+			accepted,
+			...(!accepted ? { reason: "invalid_reply" as const } : {}),
+		};
+		this.pi.events.emit(ASK_USER_REPLY_OUTCOME_EVENT, payload);
+	}
+	private closed(reason: AskUserClosedEventPayload["reason"]): void {
+		if (this.published)
+			this.pi.events.emit(ASK_USER_CLOSED_EVENT, {
+				invocationId: this.invocationId,
+				reason,
+			} satisfies AskUserClosedEventPayload);
+	}
+}

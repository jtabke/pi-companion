{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src", "web/src", "tests/**/*.ts", "*.config.ts"]
}
